<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Hệ Thống Phát Hiện Khuyết Tật Hình Dạng</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
    <div class="container-fluid px-4">
      <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
        <i class="bi bi-bounding-box-circles text-warning fs-4"></i>
        <span>Solidity QC Vision</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNavbar">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link <%= typeof active !== 'undefined' && active === 'dashboard' ? 'active fw-semibold' : '' %>" href="/">
              <i class="bi bi-speedometer2 me-1"></i>Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= typeof active !== 'undefined' && active === 'datasets' ? 'active fw-semibold' : '' %>" href="/datasets">
              <i class="bi bi-folder2-open me-1"></i>Bộ Dữ Liệu
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= typeof active !== 'undefined' && active === 'pipeline' ? 'active fw-semibold' : '' %>" href="/pipeline">
              <i class="bi bi-diagram-3 me-1"></i>Pipeline Phân Tích
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= typeof active !== 'undefined' && active === 'inspection' ? 'active fw-semibold' : '' %>" href="/inspection">
              <i class="bi bi-images me-1"></i>Phân Loại Ảnh Mới
            </a>
          </li>
          <!-- MODULE MỚI: Defect QC -->
          <li class="nav-item">
            <a class="nav-link <%= typeof active !== 'undefined' && active === 'defectqc' ? 'active fw-semibold' : '' %>" href="/defectqc">
              <i class="bi bi-shield-exclamation me-1"></i>Defect QC
              <span class="badge bg-warning text-dark ms-1" style="font-size:0.65em;vertical-align:middle;">Mới</span>
            </a>
          </li>
        </ul>
        <div class="d-flex align-items-center gap-2 text-light small">
          <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Python Core Ready</span>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="container-fluid px-4 py-4">
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="bg-white border-top py-3 mt-auto text-center text-muted small">
    <div class="container">
      Phát Hiện Khuyết Tật Bằng Tỉ Số Convex Hull &mdash; Solidity
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
